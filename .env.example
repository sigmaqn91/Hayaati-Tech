# GEMINI_API_KEY: Server-side API key for Gemini Assistant & Real-time Live Voice.
# Secret: Never expose to browser. Configured on Vercel / server environment.
GEMINI_API_KEY=""

# RESEND_API_KEY: Server-side API key for sending real emails from contact & project submission forms.
# Secret: Resend API key (https://resend.com)
RESEND_API_KEY=""

# APP_URL: Production domain URL (https://www.hayaatiweb.site)
APP_URL="https://www.hayaatiweb.site"

# NEXT_PUBLIC_APP_URL: Public domain URL for canonical references.
# Note: Any change to NEXT_PUBLIC_ variables requires a redeploy on Vercel/production.
NEXT_PUBLIC_APP_URL="https://www.hayaatiweb.site"
