# Google Gemini API key for text chat and live voice session tokens
GEMINI_API_KEY=

# Gemini model used for text chat (defaults to verified gemini-flash-latest)
GEMINI_CHAT_MODEL=

# Gemini model used for real-time Live WebSocket sessions (defaults to verified gemini-3.8-live)
GEMINI_LIVE_MODEL=

# Voice persona for speech synthesis in Gemini Live/TTS (defaults to Kore)
GEMINI_VOICE=

# Resend API key for relaying project listings and contact enquiries
RESEND_API_KEY=

# Recipient email address for incoming contact and project review enquiries
ENQUIRY_TO_EMAIL=

# Sender email address configured and verified in Resend for outgoing notifications
ENQUIRY_FROM_EMAIL=

# Canonical public website URL (e.g. https://www.hayaatiweb.site)
NEXT_PUBLIC_APP_URL=

# Upstash Redis REST URL for distributed rate limiting and session stores
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token for authenticating rate limit requests
UPSTASH_REDIS_REST_TOKEN=

# Secret key used to HMAC-sign visitor session cookies for rate-limiting
SESSION_SIGNING_SECRET=

# Maximum allowed text chat queries per visitor per 10-minute window (default: 8)
CHAT_LIMIT_PER_VISITOR=

# Maximum allowed voice sessions per visitor per hour (default: 4)
VOICE_SESSIONS_PER_VISITOR_PER_HOUR=

# Maximum duration in seconds for a single voice session (default: 180)
VOICE_SESSION_MAX_SECONDS=

# Global maximum concurrent active voice sessions allowed across all visitors (default: 5)
MAX_CONCURRENT_VOICE_SESSIONS=

# Global daily cap on total chat messages processed across all visitors (default: 2000)
GLOBAL_DAILY_CHAT_CAP=

# Global daily cap on total voice minutes processed across all visitors (default: 120)
GLOBAL_DAILY_VOICE_MINUTES_CAP=

# Maximum character length accepted for a single user message (default: 500)
MAX_MESSAGE_CHARS=
